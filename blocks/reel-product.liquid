<!-- reel-product.liquid -->
{%- doc -%}
  Compact product row for video reels: linked thumbnail, title and price of a picked product.
  Price uses the native price snippet (theme money format); unavailable products show the
  theme's sold-out label instead of a price. Styles: assets/dev1.css (.dev1-reel-product).
  Optional (off by default, so reels are unchanged): supporting text, a background tint and an
  add button. The add button is the theme's own quick-add form (snippets/quick-add.liquid) for a
  product with one variant and no selling plan, so it adds that product to the cart on its own;
  any other product gets a link to its product page to choose options there.
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign product = block_settings.product

  capture reel_product_style
    if block_settings.title_color != blank
      echo '--dev1-reel-title-color: ' | append: block_settings.title_color | append: ';'
    endif
    if block_settings.price_color != blank
      echo ' --dev1-reel-price-color: ' | append: block_settings.price_color | append: ';'
    endif
    if block_settings.thumbnail_border != blank
      echo ' --dev1-reel-thumb-border: ' | append: block_settings.thumbnail_border | append: ';'
    endif
    if block_settings.background_color != blank
      echo ' --dev1-reel-background: ' | append: block_settings.background_color | append: ';'
    endif
  endcapture

  # Direct add only when one click can add the right thing; otherwise the visitor chooses on the product page.
  assign reel_direct_add = false
  if block_settings.show_add_button and product != blank
    if product.variants_count == 1 and product.requires_selling_plan == false and product.selling_plan_groups.size == 0
      assign reel_direct_add = true
    endif
  endif
-%}

{%- if product != blank -%}
  <div
    class="dev1-reel-product"
    style="{{ reel_product_style | strip }}"
    {{ block.shopify_attributes }}
  >
    <a
      class="dev1-reel-product__thumb"
      href="{{ product.url }}"
      tabindex="-1"
      aria-hidden="true"
    >
      {%- if product.featured_image != blank -%}
        {{-
          product.featured_image
          | image_url: width: 129
          | image_tag: widths: '43, 86, 129', sizes: '43px', loading: 'lazy', alt: ''
        -}}
      {%- else -%}
        {{- 'product-1' | placeholder_svg_tag: 'dev1-reel-product__placeholder' -}}
      {%- endif -%}
    </a>
    <div class="dev1-reel-product__info">
      <a class="dev1-reel-product__title" href="{{ product.url }}">{{ product.title | escape }}</a>
      {%- if block_settings.subtitle != blank -%}
        <p class="dev1-reel-product__subtitle">{{ block_settings.subtitle | escape }}</p>
      {%- endif -%}
      <div class="dev1-reel-product__price">
        {%- if product.available -%}
          {% render 'price', product_resource: product %}
        {%- else -%}
          {{ 'content.product_badge_sold_out' | t }}
        {%- endif -%}
      </div>
    </div>
    {%- if block_settings.show_add_button -%}
      <div class="dev1-reel-product__add">
        {%- if reel_direct_add -%}
          {% render 'quick-add',
            product: product,
            section_id: section.id,
            block: block,
            icon_html: block_settings.add_icon_svg
          %}
        {%- else -%}
          <a
            class="dev1-reel-product__add-link"
            href="{{ product.url }}"
            aria-label="{{ 'actions.choose' | t }}: {{ product.title | escape }}"
          >
            {%- if block_settings.add_icon_svg != blank -%}
              <span class="dev1-reel-product__add-icon" aria-hidden="true">{{ block_settings.add_icon_svg }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- elsif request.design_mode -%}
  <div
    class="dev1-reel-product"
    style="{{ reel_product_style | strip }}"
    {{ block.shopify_attributes }}
  >
    <span class="dev1-reel-product__thumb">
      {{- 'product-1' | placeholder_svg_tag: 'dev1-reel-product__placeholder' -}}
    </span>
    <div class="dev1-reel-product__info">
      <span class="dev1-reel-product__title">{{ 'placeholders.product_title' | t }}</span>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:dev1_settings.reel_product",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:dev1_settings.product"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "t:dev1_settings.title_color",
      "default": "{{ settings.color_palette.snosha_deep_blue }}"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "t:dev1_settings.price_color",
      "default": "{{ settings.color_palette.snosha_secondary_blue }}"
    },
    {
      "type": "color",
      "id": "thumbnail_border",
      "label": "t:dev1_settings.thumbnail_border",
      "default": "{{ settings.color_palette.color2 }}"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:dev1_settings.subtitle"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:dev1_settings.background_color"
    },
    {
      "type": "checkbox",
      "id": "show_add_button",
      "label": "t:dev1_settings.show_add_button",
      "info": "t:dev1_settings.show_add_button_info",
      "default": false
    },
    {
      "type": "html",
      "id": "add_icon_svg",
      "label": "t:dev1_settings.add_icon_svg",
      "info": "t:dev1_settings.icon_svg_info",
      "default": "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M12 3.5V20.5M3.5 12H20.5' stroke='currentColor' stroke-width='1.6' stroke-linecap='round'/></svg>",
      "visible_if": "{{ block.settings.show_add_button }}"
    }
  ],
  "presets": [
    {
      "name": "t:dev1_settings.reel_product",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
