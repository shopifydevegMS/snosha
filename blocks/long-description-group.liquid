<!-- long-description-group.liquid -->
{%- comment -%}
  dev4: one informational group of the product "Long Description" (styles: assets/dev4.css → dev4-ld).
  Copy (heading, subtitle, text, note) + one image + a list of benefit-item rows (child blocks).
  Image: image_picker; the mobile image overrides it below 750px (or stands alone when no desktop
  image is set). No image picked → the theme placeholder.
{%- endcomment -%}

{%- liquid
  assign bs = block.settings
  assign heading = bs.heading | strip
  assign subtitle = bs.subtitle | strip
  assign note = bs.note | strip
  assign list_heading = bs.list_heading | strip
  assign main_image = bs.image | default: bs.image_mobile

  assign image_alt = bs.image_alt | strip
  if image_alt == blank and main_image != blank
    assign image_alt = main_image.alt
  endif
  if image_alt == blank
    assign image_alt = heading
  endif

  assign media_justify = 'center'
  if bs.media_position == 'left'
    assign media_justify = 'end'
  elsif bs.media_position == 'right'
    assign media_justify = 'start'
  endif
-%}

{%- capture rows -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

<div
  class="dev4-ld-group dev4-ld-group--{{ bs.layout }} dev4-ld-group--m-{{ bs.mobile_layout }} dev4-ld-group--v-{{ bs.vertical_alignment }}"
  style="
    --dev4-ld-copy-max: {{ bs.copy_max_width }}px;
    {%- if bs.text_max_width > 0 %} --dev4-ld-text-max: {{ bs.text_max_width }}px;{% endif %}
    --dev4-ld-media-max: {{ bs.image_max_width }}px;
    --dev4-ld-media-max-mobile: {{ bs.image_max_width_mobile }}px;
    --dev4-ld-media-justify: {{ media_justify }};
    --dev4-ld-column-gap: {{ bs.column_gap }}px;
    --dev4-ld-copy-offset: {{ bs.copy_offset }}px;
    --dev4-ld-list-offset: {{ bs.list_offset }}px;
    --dev4-ld-list-max: {{ bs.list_max_width }}px;
    --dev4-ld-list-gap: {{ bs.list_gap }}px;
    --dev4-ld-tile: {{ bs.tile_size }}px;
    --dev4-ld-tile-mobile: {{ bs.tile_size_mobile }}px;
    --dev4-ld-ratio: {% if bs.image_ratio > 0 %}100 / {{ bs.image_ratio }}{% else %}auto{% endif %};
    --dev4-ld-ratio-m: {% if bs.image_ratio_mobile > 0 %}100 / {{ bs.image_ratio_mobile }}{% else %}auto{% endif %};
    --dev4-ld-zoom: {{ bs.image_zoom | divided_by: 100.0 }};
    --dev4-ld-zoom-m: {{ bs.image_zoom_mobile | divided_by: 100.0 }};
    --dev4-ld-focus: {{ bs.image_focus_x }}% {{ bs.image_focus_y }}%;
    --dev4-ld-focus-m: {{ bs.image_focus_x_mobile }}% {{ bs.image_focus_y_mobile }}%;
    --dev4-ld-row-title-weight: {{ bs.row_title_weight }};
    --dev4-ld-row-text-weight: {{ bs.row_text_weight }};
    {%- if bs.tile_border_color != blank %}--dev4-ld-tile-border: {{ bs.tile_border_color }};{% endif -%}
  "
  {{ block.shopify_attributes }}
>
  {%- if heading != blank or subtitle != blank or bs.text != blank or note != blank -%}
    <div class="dev4-ld-group__copy">
      {%- if heading != blank -%}
        <h2 class="dev4-ld-group__heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if subtitle != blank -%}
        <p class="dev4-ld-group__subtitle">{{ subtitle }}</p>
      {%- endif -%}
      {%- if bs.text != blank -%}
        <div class="dev4-ld-group__text">{{ bs.text }}</div>
      {%- endif -%}
      {%- if note != blank -%}
        <p class="dev4-ld-group__note">{{ note | newline_to_br }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if bs.layout != 'text' -%}
    <div class="dev4-ld-group__media">
      {%- if main_image != blank -%}
        <picture>
          {%- if bs.image != blank and bs.image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ bs.image_mobile | image_url: width: 400 }} 400w, {{ bs.image_mobile | image_url: width: 800 }} 800w"
              sizes="{{ bs.image_max_width_mobile }}px"
              width="{{ bs.image_mobile.width }}"
              height="{{ bs.image_mobile.height }}"
            >
          {%- endif -%}
          {%- capture sizes -%}(min-width: 990px) {{ bs.image_max_width }}px, (max-width: 749px) {{ bs.image_max_width_mobile }}px, 50vw{%- endcapture -%}
          {{
            main_image
            | image_url: width: 1600
            | image_tag:
              class: 'dev4-ld-group__image',
              widths: '400, 600, 800, 1000, 1200, 1600',
              sizes: sizes,
              alt: image_alt,
              loading: 'lazy'
          }}
        </picture>
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'dev4-ld-group__image dev4-ld-group__placeholder' }}
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if rows != blank or list_heading != blank -%}
    <div class="dev4-ld-group__list">
      {%- if list_heading != blank -%}
        <p class="dev4-ld-group__list-heading">{{ list_heading }}</p>
      {%- endif -%}
      {{ rows }}
    </div>
  {%- endif -%}
</div>

