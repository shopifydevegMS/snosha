<!-- contact-banner.liquid -->
{%- comment -%}
  dev4: "14 Contact" banner (product page, styles: assets/dev4.css → dev4-contact-card).
  Gradient card with decorative rings, dots and sparkles (aria-hidden, behind the content), a logo
  (image picker first, then Theme settings → Logo: inverse logo, then logo), nested text blocks (heading + description)
  and two contact links:
  - WhatsApp: the complete URL from the merchant, opened in a new tab; empty URL = no link.
  - Email: a plain address turned into mailto:; an empty or invalid address = no link.
  In the Theme Editor a missing destination shows a non-interactive placeholder so the button stays editable.
{%- endcomment -%}

{%- liquid
  assign bs = block.settings

  # Logo: block image → Theme settings inverse logo (for dark backgrounds) → Theme settings logo.
  assign logo_image = bs.logo | default: settings.logo_inverse | default: settings.logo

  assign logo_alt = bs.logo_alt | strip
  if logo_alt == blank and logo_image != blank
    assign logo_alt = logo_image.alt
  endif
  if logo_alt == blank
    assign logo_alt = shop.name
  endif

  assign whatsapp_label = bs.whatsapp_label | strip
  assign whatsapp_url = bs.whatsapp_url

  assign email_label = bs.email_label | strip
  assign email = bs.email | strip | remove: 'mailto:' | remove: 'MAILTO:'
  assign email_valid = false
  if email != blank and email contains '@'
    assign email_parts = email | split: '@'
    unless email contains ' ' or email_parts.size != 2 or email_parts.first == blank or email_parts.last == blank
      assign email_valid = true
    endunless
  endif

  assign show_whatsapp = false
  if whatsapp_label != blank
    if whatsapp_url != blank or request.design_mode
      assign show_whatsapp = true
    endif
  endif

  assign show_email = false
  if email_label != blank
    if email_valid or request.design_mode
      assign show_email = true
    endif
  endif
-%}

{%- capture text_blocks -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

<div
  class="dev4-contact-card"
  style="
    --dev4-contact-logo-width: {{ bs.logo_width }}px;
    --dev4-contact-logo-width-mobile: {{ bs.logo_width_mobile }}px;
    {%- if bs.gradient_start != blank %}--dev4-contact-start: {{ bs.gradient_start }};{% endif -%}
    {%- if bs.gradient_middle != blank %}--dev4-contact-middle: {{ bs.gradient_middle }};{% endif -%}
    {%- if bs.gradient_end != blank %}--dev4-contact-end: {{ bs.gradient_end }};{% endif -%}
    {%- if bs.border_color != blank %}--dev4-contact-border: {{ bs.border_color }};{% endif -%}
    {%- if bs.shadow_color != blank %}--dev4-contact-shadow: {{ bs.shadow_color }};{% endif -%}
    {%- if bs.accent_color != blank %}--dev4-contact-accent: {{ bs.accent_color }};{% endif -%}
    {%- if bs.text_color != blank %}--dev4-contact-text: {{ bs.text_color }};{% endif -%}
    {%- if bs.primary_button_background != blank %}--dev4-contact-primary-bg: {{ bs.primary_button_background }};{% endif -%}
    {%- if bs.primary_button_text != blank %}--dev4-contact-primary-text: {{ bs.primary_button_text }};{% endif -%}
  "
  {{ block.shopify_attributes }}
>
  <span class="dev4-contact-card__decor" aria-hidden="true">
    <span class="dev4-contact-card__ring dev4-contact-card__ring--dashed"></span>
    <span class="dev4-contact-card__ring dev4-contact-card__ring--solid"></span>
    <span class="dev4-contact-card__dot dev4-contact-card__dot--1"></span>
    <span class="dev4-contact-card__dot dev4-contact-card__dot--2"></span>
    <span class="dev4-contact-card__dot dev4-contact-card__dot--3"></span>
    {%- if bs.sparkle_svg != blank -%}
      {%- for i in (1..4) -%}
        <span class="dev4-contact-card__sparkle dev4-contact-card__sparkle--{{ i }}">{{ bs.sparkle_svg }}</span>
      {%- endfor -%}
    {%- endif -%}
  </span>

  <div class="dev4-contact-card__content">
    {%- if bs.show_logo and logo_image != blank -%}
      <div class="dev4-contact-card__logo">
        {{-
          logo_image
          | image_url: width: 600
          | image_tag:
            alt: logo_alt,
            widths: '200, 300, 400, 600',
            sizes: '(min-width: 750px) 300px, 200px',
            loading: 'lazy'
        -}}
      </div>
    {%- endif -%}

    {{ text_blocks }}

    {%- if show_whatsapp or show_email -%}
      <div class="dev4-contact-card__actions">
        {%- if show_whatsapp -%}
          {%- if whatsapp_url != blank -%}
            <a
              class="dev4-contact-card__button dev4-contact-card__button--primary"
              href="{{ whatsapp_url }}"
              target="_blank"
              rel="noopener noreferrer"
            >
          {%- else -%}
            <span class="dev4-contact-card__button dev4-contact-card__button--primary dev4-contact-card__button--placeholder">
          {%- endif -%}
          {%- if bs.whatsapp_icon_svg != blank -%}
            <span class="dev4-contact-card__icon" aria-hidden="true">{{ bs.whatsapp_icon_svg }}</span>
          {%- endif -%}
          <span class="dev4-contact-card__label">{{ whatsapp_label | escape }}</span>
          {%- if whatsapp_url != blank -%}
            <span class="visually-hidden">{{ 'accessibility.new_window' | t }}</span>
            </a>
          {%- else -%}
            </span>
          {%- endif -%}
        {%- endif -%}

        {%- if show_email -%}
          {%- if email_valid -%}
            <a
              class="dev4-contact-card__button dev4-contact-card__button--secondary"
              href="mailto:{{ email | escape }}"
            >
          {%- else -%}
            <span class="dev4-contact-card__button dev4-contact-card__button--secondary dev4-contact-card__button--placeholder">
          {%- endif -%}
          {%- if bs.email_icon_svg != blank -%}
            <span class="dev4-contact-card__icon" aria-hidden="true">{{ bs.email_icon_svg }}</span>
          {%- endif -%}
          <span class="dev4-contact-card__label">{{ email_label | escape }}</span>
          {%- if email_valid -%}
            </a>
          {%- else -%}
            </span>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

