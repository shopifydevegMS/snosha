<!-- product-promo-decor.liquid -->
{%- doc -%}
  Decorative layers for the media-with-content "Design 1" product promotion (Figma "F1 Banner"):
  background waves, glow, dotted arc, background text, sparkles and bubbles.
  Purely visual: aria-hidden, no pointer events, no content. Rendered only when the section uses
  that design and "Show background decorations" is on.

  @param {object} section - The media-with-content section object

  @example
  {% render 'product-promo-decor', section: section %}
{%- enddoc -%}

{%- liquid
  assign sparkle_svg = section.settings.dev2_sparkle_icon_svg
  assign watermark = section.settings.dev2_watermark_text
  assign uid = section.id | handleize
-%}

<div class="dev2-f1__backdrop" aria-hidden="true">
  <svg
    class="dev2-f1__wave dev2-f1__wave--back"
    viewBox="0 0 1480 170"
    preserveAspectRatio="none"
    focusable="false"
  >
    <defs>
      <linearGradient id="dev2-f1-wave-back-{{ uid }}" x1="0" y1="0" x2="1" y2="0">
        <stop class="dev2-f1__stop--soft" offset="0"></stop>
        <stop class="dev2-f1__stop--tint" offset="1"></stop>
      </linearGradient>
    </defs>
    <path
      fill="url(#dev2-f1-wave-back-{{ uid }})"
      d="M0 40C240 -40 480 90 740 25C1000 -40 1240 80 1480 0V170H0V40Z"
    ></path>
  </svg>
  <svg
    class="dev2-f1__wave dev2-f1__wave--back-mobile"
    viewBox="0 0 390 44.8"
    preserveAspectRatio="none"
    focusable="false"
  >
    <defs>
      <linearGradient id="dev2-f1-wave-back-mobile-{{ uid }}" x1="0" y1="0" x2="1" y2="0">
        <stop class="dev2-f1__stop--soft" offset="0"></stop>
        <stop class="dev2-f1__stop--tint" offset="1"></stop>
      </linearGradient>
    </defs>
    <path
      fill="url(#dev2-f1-wave-back-mobile-{{ uid }})"
      d="M0 10.54C63.24 -10.54 126.49 23.72 195 6.59C263.51 -10.54 326.76 21.08 390 0V44.8H0V10.54Z"
    ></path>
  </svg>
  <svg
    class="dev2-f1__wave dev2-f1__wave--front"
    viewBox="0 0 1480 407"
    preserveAspectRatio="none"
    focusable="false"
  >
    <defs>
      <linearGradient id="dev2-f1-wave-front-{{ uid }}" x1="0" y1="0" x2="1" y2="0">
        <stop class="dev2-f1__stop--base" offset="0"></stop>
        <stop class="dev2-f1__stop--soft-light" offset="1"></stop>
      </linearGradient>
    </defs>
    <path
      fill="url(#dev2-f1-wave-front-{{ uid }})"
      d="M0 125.23C300 -93.92 560 250.46 820 62.62C1080 -109.58 1280 187.85 1480 0V407H0V125.23Z"
    ></path>
  </svg>
</div>

{%- comment -%}
  Two stage layers share the media grid area: glow + dotted arc sit under the front wave,
  background text, bubbles and sparkles sit above it (Figma layer order).
{%- endcomment -%}
<div class="dev2-f1__stage dev2-f1__stage--under" aria-hidden="true">
  <div class="dev2-f1__orbit">
    <span class="dev2-f1__glow"></span>
    <svg class="dev2-f1__arc" focusable="false">
      <defs>
        <linearGradient id="dev2-f1-arc-{{ uid }}" x1="0" y1="0" x2="1" y2="1">
          <stop class="dev2-f1__stop--accent" offset="0"></stop>
          <stop class="dev2-f1__stop--highlight" offset="1"></stop>
        </linearGradient>
      </defs>
      <circle cx="50%" cy="50%" stroke="url(#dev2-f1-arc-{{ uid }})"></circle>
    </svg>
  </div>
</div>

<div class="dev2-f1__stage dev2-f1__stage--over" aria-hidden="true">
  <div class="dev2-f1__orbit">
    {%- if watermark != blank -%}
      <span class="dev2-f1__watermark">{{ watermark | escape }}</span>
    {%- endif -%}
    {%- for i in (1..9) -%}
      <span class="dev2-f1__bubble dev2-f1__bubble--{{ i }}"></span>
    {%- endfor -%}
    {%- if sparkle_svg != blank -%}
      {%- for i in (1..3) -%}
        <span class="dev2-f1__sparkle dev2-f1__sparkle--{{ i }}">{{ sparkle_svg }}</span>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>
