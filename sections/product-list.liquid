

{% liquid
  assign max_items = section.settings.max_products
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}{% if section.settings.design == 'dev1' %}
  {%- comment -%} dev1: "Design 1" (06 Featured Collection) — per-instance values for assets/dev1.css {%- endcomment -%}
  {% style %}
    #shopify-section-{{ section.id }} {
      --dev1-columns-tablet: {{ section.settings.dev1_columns_tablet }};
      {%- if section.settings.dev1_padding_mobile_top > 0 %} --dev1-padding-mobile-top: {{ section.settings.dev1_padding_mobile_top }}px;{% endif %}
      {%- if section.settings.dev1_padding_mobile_bottom > 0 %} --dev1-padding-mobile-bottom: {{ section.settings.dev1_padding_mobile_bottom }}px;{% endif %}
      {%- if section.settings.dev1_discount_background != blank %} --dev1-discount-background: {{ section.settings.dev1_discount_background }};{% endif %}
      {%- if section.settings.dev1_discount_border != blank %} --dev1-discount-border: {{ section.settings.dev1_discount_border }};{% endif %}
      {%- if section.settings.dev1_discount_text != blank %} --dev1-discount-text: {{ section.settings.dev1_discount_text }};{% endif %}
      {%- if section.settings.dev1_progress_track != blank %} --dev1-progress-track: {{ section.settings.dev1_progress_track }};{% endif %}
      {%- if section.settings.dev1_progress_start != blank %} --dev1-progress-start: {{ section.settings.dev1_progress_start }};{% endif %}
      {%- if section.settings.dev1_progress_end != blank %} --dev1-progress-end: {{ section.settings.dev1_progress_end }};{% endif %}
      {%- if section.settings.dev1_shadow_color != blank %} --dev1-shadow-color: {{ section.settings.dev1_shadow_color }};{% endif %}
    }
  {% endstyle %}
{% endif %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  data-testid="product-list"
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    section-resource-list
    spacing-style
    gap-style{% if section.settings.design == 'dev1' %} dev1-featured{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  <div class="section-resource-list__header">
    {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
  </div>

  {% capture list_items %}
    {% if section.settings.collection != blank and shop.products_count != 0 %}
      {% paginate section.settings.collection.products by max_items %}
        {% for product in section.settings.collection.products limit: max_items %}
        <div
          class="resource-list__item"
        >
            {% content_for 'block',
              type: '_product-card',
              id: 'static-product-card',
              closest.product: product,
              product_view_context: 'collection'
            %}
          </div>

          {% unless forloop.last %}
            <!--@list/split-->
          {% endunless %}
        {% endfor %}
      {% endpaginate %}
    {% else %}
      {% for i in (1..max_items) %}
        <div
          class="resource-list__item"
        >
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    slide_count: max_items,
    content_type: 'products',
    test_id: 'resource-list-grid'
  %}{% if section.settings.design == 'dev1' %}{% liquid
      assign dev1_has_mobile_carousel = section.settings.carousel_on_mobile
      if section.settings.layout_type == 'carousel'
        assign dev1_has_mobile_carousel = true
      endif
    %}{% if dev1_has_mobile_carousel %}
  {%- comment -%} dev1: visual-only progress for the native mobile carousel (assets/dev1.js) {%- endcomment -%}
  <dev1-carousel-progress class="dev1-featured__progress hidden--desktop" aria-hidden="true">
    <span class="dev1-featured__progress-fill"></span>
  </dev1-carousel-progress>
  <script src="{{ 'dev1.js' | asset_url }}" type="module"></script>
{% endif %}{% endif %}

  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

