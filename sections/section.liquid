

{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{%- liquid
  # dev4: Design 1 scope class for assets/dev4.css; empty = native output
  assign section_class = ''
  if section.settings.design == 'dev4'
    assign section_class = 'dev4-before-after'
  endif
  # dev3: Design 2 (11 Bundle) scope class for assets/dev3.css
  if section.settings.design == 'dev3'
    assign section_class = 'dev3-bundle'
  endif
  # dev1: Design 3 (10 Why SNOSHA) scope class for assets/dev1.css
  if section.settings.design == 'dev1'
    assign section_class = 'dev1-why'
  endif
  # dev2: Design 4 (14 FAQ) scope class for assets/dev2.css
  if section.settings.design == 'dev2'
    assign section_class = 'dev2-faq'
  endif
  # dev4: Design 5 (product Long Description) scope class for assets/dev4.css
  if section.settings.design == 'dev4_long'
    assign section_class = 'dev4-ld'
  endif
  # dev3: Design 6 (product How To Use Video) scope class for assets/dev3.css
  if section.settings.design == 'dev3_video'
    assign section_class = 'dev3-howto'
  endif
  # dev2: Design 7 (product 06 Comparison) scope class for assets/dev2.css
  if section.settings.design == 'dev2_compare'
    assign section_class = 'dev2-cmp-section'
  endif
  # dev4: Design 8 (product 09 How To Use) scope class for assets/dev4.css
  if section.settings.design == 'dev4_howto'
    assign section_class = 'dev4-howto'
  endif
  # dev2: Design 9 (product 08 Reviews, Judge.me app block) scope class for assets/dev2.css
  if section.settings.design == 'dev2_reviews'
    assign section_class = 'dev2-reviews'
  endif
  # dev1: Design 10 (product 09 Before After) scope class for assets/dev1.css
  if section.settings.design == 'dev1_results'
    assign section_class = 'dev1-results'
  endif
-%}

{%- if section.settings.design == 'dev3' -%}
  {%- comment -%} dev3: per-instance values and palette colors for assets/dev3.css (Design 2 only) {%- endcomment -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --dev3-bundle-padding-top-mobile: {{ section.settings.dev3_padding_top_mobile }}px;
      --dev3-bundle-padding-bottom-mobile: {{ section.settings.dev3_padding_bottom_mobile }}px;
      --dev3-bundle-heading: {{ settings.color_palette.snosha_deep_blue }};
      --dev3-bundle-muted: {{ settings.color_palette.color1 }};
      --dev3-bundle-line: {{ settings.color_palette.color2 }};
      --dev3-bundle-brand: {{ settings.color_palette.snosha_secondary_blue }};
      --dev3-bundle-accent: {{ settings.color_palette.snosha_primary_blue }};
      --dev3-bundle-surface: {{ settings.color_palette.background }};
      --dev3-bundle-tint: {{ settings.color_palette.snosha_pale_tint }};
      --dev3-bundle-shadow-rgb: {{ settings.color_palette.snosha_gradient_end.rgb }};
    }
  {%- endstyle -%}
{%- endif -%}

{%- if section.settings.design == 'dev4' -%}
  {%- comment -%} dev4: per-instance values for assets/dev4.css (Design 1 only) {%- endcomment -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --dev4-padding-top-mobile: {{ section.settings.dev4_padding_top_mobile }}px;
      --dev4-padding-bottom-mobile: {{ section.settings.dev4_padding_bottom_mobile }}px;
      {%- if section.settings.dev4_shadow_color != blank %}
        --dev4-ba-shadow-color: rgb({{ section.settings.dev4_shadow_color.rgba }});
      {%- endif %}
    }
  {%- endstyle -%}
  <script src="{{ 'dev4.js' | asset_url }}" type="module"></script>
{%- endif -%}

{%- if section.settings.design == 'dev1' or section.settings.design == 'dev1_results' -%}
  {%- comment -%} dev1: per-instance values for assets/dev1.css (Design 3 — 10 Why SNOSHA; Design 10 — product 09 Before After) {%- endcomment -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      {%- if section.settings.dev1_feature_title_color != blank %} --dev1-why-title: {{ section.settings.dev1_feature_title_color }};{% endif %}
      {%- if section.settings.dev1_padding_mobile_top > 0 %} --dev1-padding-mobile-top: {{ section.settings.dev1_padding_mobile_top }}px;{% endif %}
      {%- if section.settings.dev1_padding_mobile_bottom > 0 %} --dev1-padding-mobile-bottom: {{ section.settings.dev1_padding_mobile_bottom }}px;{% endif %}
    }
  {%- endstyle -%}
{%- endif -%}

{%- if section.settings.design == 'dev2' -%}
  {%- comment -%} dev2: per-instance colors for assets/dev2.css (Design 4 — 14 FAQ) {%- endcomment -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      {%- if section.settings.dev2_faq_border_color != blank %} --dev2-faq-border: {{ section.settings.dev2_faq_border_color }};{% endif %}
      {%- if section.settings.dev2_faq_open_background != blank %} --dev2-faq-open-background: {{ section.settings.dev2_faq_open_background }};{% endif %}
      {%- if section.settings.dev2_faq_icon_color != blank %} --dev2-faq-icon: {{ section.settings.dev2_faq_icon_color }};{% endif %}
    }
  {%- endstyle -%}
  {%- if section.settings.dev2_faq_open_first -%}
    {%- comment -%} dev2: opens the first question in reading order (desktop and mobile), assets/dev2.js {%- endcomment -%}
    <dev2-faq-open-first hidden></dev2-faq-open-first>
    <script src="{{ 'dev2.js' | asset_url }}" type="module"></script>
  {%- endif -%}
{%- endif -%}

{%- if section.settings.design == 'dev4_long' -%}
  {%- comment -%} dev4: per-instance colors for assets/dev4.css (Design 5 — product Long Description) {%- endcomment -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      {%- if section.settings.dev4_ld_gradient_start != blank %} --dev4-ld-gradient-start: {{ section.settings.dev4_ld_gradient_start }};{% endif %}
      {%- if section.settings.dev4_ld_gradient_end != blank %} --dev4-ld-gradient-end: {{ section.settings.dev4_ld_gradient_end }};{% endif %}
      {%- if section.settings.dev4_ld_heading_color != blank %} --dev4-ld-heading: {{ section.settings.dev4_ld_heading_color }};{% endif %}
      {%- if section.settings.dev4_ld_text_color != blank %} --dev4-ld-text: {{ section.settings.dev4_ld_text_color }};{% endif %}
      {%- if section.settings.dev4_ld_icon_color != blank %} --dev4-ld-icon: {{ section.settings.dev4_ld_icon_color }};{% endif %}
      {%- if section.settings.dev4_ld_tile_border_color != blank %} --dev4-ld-tile-border: {{ section.settings.dev4_ld_tile_border_color }};{% endif %}
      {%- if section.settings.dev4_ld_tile_shadow != blank %} --dev4-ld-tile-shadow: rgb({{ section.settings.dev4_ld_tile_shadow.rgba }});{% endif %}
    }
  {%- endstyle -%}
{%- endif -%}

{%- if section.settings.design == 'dev3_video' -%}
  {%- comment -%} dev3: palette colors for assets/dev3.css (Design 6 — How To Use Video) {%- endcomment -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --dev3-howto-button: {{ settings.color_palette.background }};
      --dev3-howto-icon: {{ settings.color_palette.snosha_secondary_blue | default: settings.color_palette.foreground }};
      --dev3-howto-shade-rgb: {{ settings.color_palette.snosha_deep_blue.rgb | default: settings.color_palette.foreground.rgb }};
    }
  {%- endstyle -%}
{%- endif -%}

{%- if section.settings.design == 'dev2_compare' -%}
  {%- comment -%} dev2: background gradient, shadow and palette colors for assets/dev2.css (Design 7 — 06 Comparison) {%- endcomment -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      {%- if section.settings.dev2_cmp_gradient_start != blank %} --dev2-cmp-bg-start: {{ section.settings.dev2_cmp_gradient_start }};{% endif %}
      {%- if section.settings.dev2_cmp_gradient_middle != blank %} --dev2-cmp-bg-middle: {{ section.settings.dev2_cmp_gradient_middle }};{% endif %}
      {%- if section.settings.dev2_cmp_gradient_end != blank %} --dev2-cmp-bg-end: {{ section.settings.dev2_cmp_gradient_end }};{% endif %}
      {%- if section.settings.dev2_cmp_shadow_color != blank %} --dev2-cmp-shadow-rgb: {{ section.settings.dev2_cmp_shadow_color.rgb }};{% endif %}
      --dev2-cmp-light-rgb: {{ settings.color_palette.background.rgb }};
      --dev2-cmp-tint: {{ settings.color_palette.snosha_pale_tint | default: settings.color_palette.background }};
      --dev2-cmp-strong: {{ settings.color_palette.snosha_deep_blue | default: settings.color_palette.foreground }};
      --dev2-cmp-line-rgb: {{ settings.color_palette.snosha_secondary_blue.rgb | default: settings.color_palette.foreground.rgb }};
      --dev2-cmp-glow-rgb: {{ settings.color_palette.snosha_gradient_start.rgb | default: settings.color_palette.background.rgb }};
    }
  {%- endstyle -%}
{%- endif -%}

{%- if section.settings.design == 'dev2_reviews' -%}
  {%- comment -%} dev2: palette colors + product title for the Judge.me cards in assets/dev2.css (Design 9 — 08 Reviews) {%- endcomment -%}
  {%- liquid
    assign dev2_reviews_product = closest.product.title | default: product.title
    assign dev2_reviews_product = dev2_reviews_product | replace: '\', '\\' | replace: '"', '\22 ' | replace: '<', '\3c ' | strip_newlines
  -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --dev2-reviews-star: {{ settings.color_palette.snosha_secondary_blue | default: settings.color_palette.foreground }};
      --dev2-reviews-border: {{ settings.color_palette.color2 | default: settings.color_palette.foreground }};
      --dev2-reviews-shadow-rgb: {{ settings.color_palette.snosha_deep_blue.rgb | default: settings.color_palette.foreground.rgb }};
      --dev2-reviews-quote-rgb: {{ settings.color_palette.snosha_gradient_start.rgb | default: settings.color_palette.foreground.rgb }};
      --dev2-reviews-muted-rgb: {{ settings.color_palette.color1.rgb | default: settings.color_palette.foreground.rgb }};
      --dev2-reviews-fill-start: {{ settings.color_palette.snosha_gradient_start | default: settings.color_palette.foreground }};
      --dev2-reviews-fill-end: {{ settings.color_palette.snosha_gradient_end | default: settings.color_palette.foreground }};
      {%- if dev2_reviews_product != blank %} --dev2-reviews-product: "{{ dev2_reviews_product }}";{% endif %}
    }
  {%- endstyle -%}
{%- endif -%}

{% render 'section',
  section: section,
  children: children,
  section_id: section.id,
  background_color: section.settings.background_color,
  class: section_class
%}

{% schema %}
{
  "name": "t:names.section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "design",
      "label": "t:dev4_settings.design",
      "options": [
        {
          "value": "default",
          "label": "t:dev4_settings.design_default"
        },
        {
          "value": "dev4",
          "label": "t:dev4_settings.design_dev4"
        },
        {
          "value": "dev3",
          "label": "t:dev3_settings.design_2"
        },
        {
          "value": "dev1",
          "label": "t:dev1_settings.design_3"
        },
        {
          "value": "dev2",
          "label": "t:dev2_settings.design_4"
        },
        {
          "value": "dev4_long",
          "label": "t:dev4_settings.design_5"
        },
        {
          "value": "dev3_video",
          "label": "t:dev3_settings.design_6"
        },
        {
          "value": "dev2_compare",
          "label": "t:dev2_settings.design_7"
        },
        {
          "value": "dev4_howto",
          "label": "t:dev4_settings.design_8"
        },
        {
          "value": "dev2_reviews",
          "label": "t:dev2_settings.design_9"
        },
        {
          "value": "dev1_results",
          "label": "t:dev1_settings.design_10"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.direction_start"
        },
        {
          "value": "center",
          "label": "t:options.direction_center"
        },
        {
          "value": "flex-end",
          "label": "t:options.direction_end"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "align_baseline",
      "label": "t:settings.align_baseline",
      "default": false,
      "visible_if": "{{ section.settings.vertical_alignment == 'flex-end' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.direction_start"
        },
        {
          "value": "center",
          "label": "t:options.direction_center"
        },
        {
          "value": "flex-end",
          "label": "t:options.direction_end"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "",
          "label": "t:options.auto"
        },
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "full-screen",
          "label": "t:options.full_screen"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "t:settings.custom_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:settings.background_media",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.background_media == 'none' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "t:settings.video_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "t:settings.image_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "fit",
          "label": "t:options.fit"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:settings.background_overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:settings.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        {
          "value": "to top",
          "label": "t:options.up"
        },
        {
          "value": "to bottom",
          "label": "t:options.down"
        }
      ],
      "default": "to top",
      "visible_if": "{{ section.settings.toggle_overlay and section.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:dev4_settings.dev4_design_header",
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "range",
      "id": "dev4_compare_start",
      "label": "t:dev4_settings.compare_start",
      "info": "t:dev4_settings.compare_start_info",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "range",
      "id": "dev4_padding_top_mobile",
      "label": "t:dev4_settings.padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "range",
      "id": "dev4_padding_bottom_mobile",
      "label": "t:dev4_settings.padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.design == 'dev4' }}"
