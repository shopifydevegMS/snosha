

{% liquid
  assign max_items = section.settings.post_limit
%}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{%- liquid
  # dev4: Design 1 ("13 Blog") — subtitle, view-all links and the mobile progress bar
  assign dev4_blog = false
  if section.settings.design == 'dev4'
    assign dev4_blog = true
  endif
-%}

{%- if dev4_blog -%}
  {%- comment -%} dev4: per-instance values for assets/dev4.css (Design 1 only) {%- endcomment -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --dev4-columns-tablet: {{ section.settings.dev4_columns_tablet }};
      --dev4-padding-top-mobile: {{ section.settings.dev4_padding_top_mobile }}px;
      --dev4-padding-bottom-mobile: {{ section.settings.dev4_padding_bottom_mobile }}px;
      {%- if section.settings.dev4_title_color != blank %}
        --dev4-blog-title: {{ section.settings.dev4_title_color }};
      {%- endif %}
      {%- if section.settings.dev4_subtitle_color != blank %}
        --dev4-blog-subtitle: {{ section.settings.dev4_subtitle_color }};
      {%- endif %}
      {%- if section.settings.dev4_link_color != blank %}
        --dev4-blog-link: {{ section.settings.dev4_link_color }};
      {%- endif %}
      {%- if section.settings.dev4_progress_track != blank %}
        --dev4-progress-track: {{ section.settings.dev4_progress_track }};
      {%- endif %}
      {%- if section.settings.dev4_progress_start != blank %}
        --dev4-progress-start: {{ section.settings.dev4_progress_start }};
      {%- endif %}
      {%- if section.settings.dev4_progress_end != blank %}
        --dev4-progress-end: {{ section.settings.dev4_progress_end }};
      {%- endif %}
    }
  {%- endstyle -%}
  <script src="{{ 'dev4.js' | asset_url }}" type="module"></script>

  {%- liquid
    assign dev4_view_all = blank
    if section.settings.blog != blank and section.settings.dev4_view_all_label != blank
      assign dev4_view_all_label = section.settings.dev4_view_all_label | escape
      capture dev4_view_all
        echo '<span>' | append: dev4_view_all_label | append: '</span>'
        if section.settings.dev4_arrow_svg != blank
          echo '<span class="dev4-blog__arrow" aria-hidden="true">' | append: section.settings.dev4_arrow_svg | append: '</span>'
        endif
      endcapture
    endif
  -%}
{%- endif -%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    section-resource-list
    spacing-style
    gap-style
    {% if dev4_blog %}dev4-blog{% endif %}
  "
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    {%- render 'gap-style', value: section.settings.gap -%}
  "
>
  {%- capture blog_title_block -%}
    {% content_for 'block', id: 'static-blog-title', type: '_featured-blog-posts-title' %}
  {%- endcapture -%}

  {%- if dev4_blog -%}
    <div class="dev4-blog__header">
      <div class="dev4-blog__heading">
        {{ blog_title_block }}
        {%- if section.settings.dev4_subtitle != blank -%}
          <p class="dev4-blog__subtitle">{{ section.settings.dev4_subtitle | escape }}</p>
        {%- endif -%}
      </div>
      {%- if dev4_view_all != blank -%}
        <a class="dev4-blog__view-all dev4-blog__view-all--desktop" href="{{ section.settings.blog.url }}">
          {{- dev4_view_all -}}
        </a>
      {%- endif -%}
    </div>
  {%- else -%}
    {{ blog_title_block }}
  {%- endif %}

  {% if section.settings.blog != blank and section.settings.blog.articles_count > 0 %}
    {% paginate section.settings.blog.articles by max_items %}
      {% assign section_articles = section.settings.blog.articles %}
    {% endpaginate %}
  {% else %}
    {% assign section_articles = '' %}
    {% for i in (1..max_items) %}
      {% assign section_articles = section_articles | append: ', ' %}
    {% endfor %}
    {% assign section_articles = section_articles | split: ',' %}
  {% endif %}

  {% capture list_items %}
    {% for article in section_articles limit: max_items %}
      <div class="resource-list__item">
        {% content_for 'block', id: 'static-blog-post-card', type: '_featured-blog-posts-card', article: article, closest.article: article %}
      </div>
      {% unless forloop.last %}
        <!--@list/split-->
      {% endunless %}
    {% endfor %}
  {% endcapture %}

  {% liquid
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    carousel_ref: 'featuredBlog',
    slide_count: max_items,
    content_type: 'articles',
    test_id: 'featured-blog-posts'
  %}

  {%- if dev4_blog -%}
    {%- comment -%} dev4: visual-only mobile scroll indicator (assets/dev4.js) and the mobile view-all link {%- endcomment -%}
    <dev4-carousel-progress class="dev4-blog__progress" aria-hidden="true">
      <span class="dev4-blog__progress-fill"></span>
    </dev4-carousel-progress>
    {%- if dev4_view_all != blank -%}
      <a class="dev4-blog__view-all dev4-blog__view-all--mobile" href="{{ section.settings.blog.url }}">
        {{- dev4_view_all -}}
      </a>
    {%- endif -%}
  {%- endif %}
</div>

{% schema %}
{
  "name": "t:names.blog_posts",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "class": "featured-blog-posts",
  "blocks": [
    {
      "type": "_featured-blog-posts-title"
    },
    {
      "type": "_featured-blog-posts-card"
    },
    {
      "type": "_featured-blog-posts-image"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "design",
      "label": "t:dev4_settings.design",
      "options": [
        {
          "value": "default",
          "label": "t:dev4_settings.design_default"
        },
        {
          "value": "dev4",
          "label": "t:dev4_settings.design_dev4"
        }
      ],
      "default": "default"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:settings.blog"
    },
    {
      "type": "header",
      "content": "t:content.cards_layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        },
        {
          "value": "editorial",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "t:settings.post_count",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "60cqw",
          "label": "t:options.one_number"
        },
        {
          "value": "44cqw",
          "label": "t:options.two_number"
        }
      ],
      "default": "60cqw",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:dev4_settings.dev4_design_header",
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "text",
      "id": "dev4_subtitle",
      "label": "t:dev4_settings.blog_subtitle",
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "text",
      "id": "dev4_read_more_label",
      "label": "t:dev4_settings.read_more_label",
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "text",
      "id": "dev4_view_all_label",
      "label": "t:dev4_settings.view_all_label",
      "info": "t:dev4_settings.view_all_info",
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "html",
      "id": "dev4_arrow_svg",
      "label": "t:dev4_settings.arrow_svg",
      "info": "t:dev4_settings.arrow_svg_info",
      "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M19 12H5M11 18L5 12L11 6\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>",
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "range",
      "id": "dev4_columns_tablet",
      "label": "t:dev4_settings.columns_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "range",
      "id": "dev4_padding_top_mobile",
      "label": "t:dev4_settings.padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "range",
      "id": "dev4_padding_bottom_mobile",
      "label": "t:dev4_settings.padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "color",
      "id": "dev4_title_color",
      "label": "t:dev4_settings.title_color",
      "info": "t:dev4_settings.title_color_info",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "color",
      "id": "dev4_subtitle_color",
      "label": "t:dev4_settings.subtitle_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "color",
      "id": "dev4_link_color",
      "label": "t:dev4_settings.link_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "color",
      "id": "dev4_progress_track",
      "label": "t:dev4_settings.progress_track",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "color",
      "id": "dev4_progress_start",
      "label": "t:dev4_settings.progress_start",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    },
    {
      "type": "color",
      "id": "dev4_progress_end",
      "label": "t:dev4_settings.progress_end",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.design == 'dev4' }}"
    }
  ],
