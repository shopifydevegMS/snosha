            "note_icon_color": ""
          },
          "blocks": {
            "dev4_howto_step_1": {
              "type": "_how-to-step",
              "settings": {
                "text": "ضع كمية مناسبة من معجون الأسنان على رأس الفرشاة."
              },
              "blocks": {}
            },
            "dev4_howto_step_2": {
              "type": "_how-to-step",
              "settings": {
                "text": "ضع الفرشاة داخل الفم أولًا، ثم شغّل الجهاز (لتجنب تناثر المعجون)."
              },
              "blocks": {}
            },
            "dev4_howto_step_3": {
              "type": "_how-to-step",
              "settings": {
                "text": "اختر وضع التنظيف المناسب لاحتياجك."
              },
              "blocks": {}
            },
            "dev4_howto_step_4": {
              "type": "_how-to-step",
              "settings": {
                "text": "حرّك الفرشاة بزاوية 45 درجة على خط اللثة، بحركة بطيئة ذهابًا وإيابًا."
              },
              "blocks": {}
            },
            "dev4_howto_step_5": {
              "type": "_how-to-step",
              "settings": {
                "text": "لا داعي للضغط بقوة؛ الفرشاة مصممة لتنظيف فعّال دون أي جهد إضافي منك."
              },
              "blocks": {}
            },
            "dev4_howto_step_6": {
              "type": "_how-to-step",
              "settings": {
                "text": "قسّم الفم إلى 4 أرباع، ونظّف كل ربع لمدة 30 ثانية تقريبًا — المؤقت الذكي ينبّهك تلقائيًا بنبضة خفيفة عند نهاية كل ربع."
              },
              "blocks": {}
            },
            "dev4_howto_step_7": {
              "type": "_how-to-step",
              "settings": {
                "text": "بعد الانتهاء، اضغط مطولًا على زر التشغيل لمدة 3 ثوانٍ لإيقاف الجهاز."
              },
              "blocks": {}
            },
            "dev4_howto_step_8": {
              "type": "_how-to-step",
              "settings": {
                "text": "لاستخدام حقيبة السفر: افتحها، ضع جسم الفرشاة مع إمكانية إضافة رأسين إضافيين، وأغلقها بإحكام لحماية الفرشاة أثناء السفر."
              },
              "blocks": {}
            }
          },
          "block_order": [
            "dev4_howto_step_1",
