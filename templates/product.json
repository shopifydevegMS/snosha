    "dev4_long_description": {
      "type": "section",
      "blocks": {
        "dev4_ld_intro": {
          "type": "long-description-group",
          "settings": {
            "heading": "وصف المنتج",
            "subtitle": "",
            "text": "<p>فرشاة أسنان Snosha N2 مصممة لتقدّم تجربة تنظيف احترافية داخل المنزل، بتقنية سونيك تجمع بين القوة والأمان على الأسنان واللثة. صُنعت الفرشاة طبقًا لمعايير السلامة الصينية المعتمدة GB4706.1-2005 وGB4706.59-2008 وGB39669-2020 — وهي تفاصيل تعكس جدية سنوشا في اختيار منتج آمن وموثوق لعملائها.</p>",
            "note": "",
            "list_heading": "",
            "image_alt": "",
            "layout": "text",
            "mobile_layout": "stacked",
            "vertical_alignment": "top",
